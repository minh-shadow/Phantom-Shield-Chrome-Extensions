{
  "manifest_version": 3,
  "name": "Phantom Shield",
  "version": "5.3.0",
  "minimum_chrome_version": "119",
  "description": "Lướt web như một bóng ma.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "toggle-all": {
      "suggested_key": { "default": "Alt+Z" },
      "description": "Bật/Tắt toàn bộ (Alt+Z)"
    },
    "open-google": {
      "suggested_key": { "default": "Alt+X" },
      "description": "Google Search (Alt+X)"
    },
    "open-chatgpt": {
      "suggested_key": { "default": "Alt+C" },
      "description": "ChatGPT (Alt+C)"
    },
    "open-deepseek": {
      "suggested_key": { "default": "Alt+V" },
      "description": "DeepSeek (Alt+V)"
    },
    "open-claude": {
      "description": "Claude AI (Alt+B)"
    },
    "close-windows": {
      "description": "Đóng tất cả cửa sổ (Alt+D)"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["spoof.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
